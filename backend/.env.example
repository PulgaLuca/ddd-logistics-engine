# Copia questo file in .env e inserisci i dati del tuo database user Atlas.
# Mantieni l'URI Atlas con il segnaposto <db_password>; il loader sostituisce il valore da MONGODB_PASSWORD.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=logisticsengine
# Se MONGODB_URI è valorizzata, l'API sceglie MongoDB automaticamente.
# Per selezionare esplicitamente un provider: MongoDb oppure Json.
STORAGE_PROVIDER=MongoDb
