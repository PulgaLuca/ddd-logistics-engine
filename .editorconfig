root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{yml,yaml,json}]
indent_size = 2

[*.cs]
indent_size = 4

# --- .NET code style ---
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false

# Unused usings must fail the build / format check
dotnet_diagnostic.IDE0005.severity = warning

# I file sono raggruppati in cartelle per entità (Controllers/Shipments, ...)
# mantenendo però namespace stabili: non imponiamo la corrispondenza cartella-namespace.
dotnet_diagnostic.IDE0130.severity = none

# 'Error' è il nome idiomatico nel Result pattern: il conflitto con la
# keyword riservata di altri linguaggi (CA1716) qui non è rilevante.
dotnet_diagnostic.CA1716.severity = none

# Il Result pattern espone factory statiche sul tipo generico Result<T>
# (Success/Failure/ValidationFailure): è intenzionale, CA1000 non si applica.
dotnet_diagnostic.CA1000.severity = none

# Le strutture dati di dominio modellano deliberatamente Stack/Queue/PriorityQueue
# (DispatchHistoryStack, OrderProcessingQueue, ...): consentiamo questi suffissi
# mantenendo CA1711 attiva per tutti gli altri.
dotnet_code_quality.CA1711.allowed_suffixes = Stack|Queue

# --- Naming conventions ---
# Interfaces must start with I
dotnet_naming_rule.interfaces_begin_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_i
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# Private fields are _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
