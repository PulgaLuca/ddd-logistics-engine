# Copiare in ".env" e adattare. Docker Compose legge automaticamente il file
# ".env" della directory da cui viene lanciato.
# Tutte le variabili hanno un default nel docker-compose.yml: il file serve solo
# per sovrascriverle (porte già occupate, credenziali diverse, chiave JWT reale).

# --- PostgreSQL ---
POSTGRES_DB=logistics
POSTGRES_USER=logistics
POSTGRES_PASSWORD=logistics
# Porta sull'host. 5433 evita il conflitto con PostgreSQL installato localmente.
POSTGRES_PORT=5433

# --- API ---
API_PORT=8080
# Development abilita Swagger sulla root dell'API.
ASPNETCORE_ENVIRONMENT=Development

# Chiave di firma dei token JWT: almeno 32 caratteri.
# In un ambiente reale va generata e tenuta fuori dal repository.
JWT_KEY=dev-only-0123456789ABCDEF0123456789
JWT_ISSUER=Dhexby.LogisticsEngine
JWT_AUDIENCE=Dhexby.LogisticsEngine.Api

# --- Frontend ---
FRONTEND_PORT=8081
# Indirizzo con cui il browser raggiunge l'API (deve combaciare con API_PORT).
API_BASE_URL=http://localhost:8080

# --- pgAdmin (profilo "tools") ---
PGADMIN_PORT=8082
PGADMIN_EMAIL=admin@logistics.local
PGADMIN_PASSWORD=admin
